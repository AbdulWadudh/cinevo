#!/bin/sh
# agent-kit: refuse a commit that leaves the active task's declared write set.
# Silent when no task is open. Bypass with --no-verify (visible in the log, on purpose).
if [ -f scripts/agent-kit.mjs ]; then
  if command -v bun >/dev/null 2>&1; then
    bun scripts/agent-kit.mjs task guard || exit 1
  else
    node scripts/agent-kit.mjs task guard || exit 1
  fi
fi
