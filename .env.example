# Cinevo environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the documented
# surface and is the only env file that may be committed.
# Values for the K79 deployment live in Infisical: project K79, folder /Cinevo,
# environment Production (13 keys; dev and staging folders do not exist yet).
#
# Keys are written commented out on purpose: `prisma.config.ts` reads an empty
# DIRECT_URL as a value, so a blank assignment breaks `prisma migrate` instead of
# falling back to DATABASE_URL. Uncomment a key once you have its value.

# ── Database (Prisma) ─────────────────────────────────────────────────────────
# Pooled Postgres URL, used by the app at runtime (Supabase transaction pooler,
# port 6543, or any pooled Postgres).
#DATABASE_URL=
# Session pooler / direct URL; `prisma migrate` reads it before DATABASE_URL.
#DIRECT_URL=

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Both are inlined into the client bundle, so they must exist at build time.
#NEXT_PUBLIC_SUPABASE_URL=
#NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── TMDb ──────────────────────────────────────────────────────────────────────
# v3 key, sent as the `api_key` query parameter.
#TMDB_API_KEY=
# v4 read access token, sent as `Authorization: Bearer`.
#TMDB_ACCESS_TOKEN=

# ── Web Push ──────────────────────────────────────────────────────────────────
# Generate once with `npx web-push generate-vapid-keys` and keep them stable:
# regenerating invalidates every existing push subscription.
#VAPID_PUBLIC_KEY=
# Must be the same value as VAPID_PUBLIC_KEY; inlined into the client bundle.
#NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com

# ── Push cron ─────────────────────────────────────────────────────────────────
# Bearer token the scheduler sends to /api/push/run. CRON_SECRET is Vercel's
# equivalent; either one is accepted.
#PUSH_CRON_SECRET=
#CRON_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
# Public origin for OAuth and email redirects. Read at runtime before
# NEXT_PUBLIC_SITE_URL, so a self-hosted image can change it without a rebuild.
# Falls back to forwarded host headers, then http://localhost:3000.
SITE_URL=http://localhost:3000
# Baked in at build time; used only when SITE_URL is unset at runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Not read by the app (kept from earlier setups) ────────────────────────────
#NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#NEXT_PUBLIC_TMDB_API_KEY=
