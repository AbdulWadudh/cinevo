# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ── Android TWA (Bubblewrap) ──
# Signing key — NEVER commit. Losing or leaking it means you can't update the app.
*.keystore
*.jks
android.keystore
# Build outputs & local Gradle/SDK state (under android-twa/)
.gradle/
build/
android-twa/app/build/
*.aab
*.idsig
local.properties
# Bubblewrap may persist signing-key passwords here:
android-signing-key-info.json
app-release-unsigned-aligned.apk
