// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String          @id // Synced with Supabase Auth user ID (UUID)
  email         String          @unique
  username      String?
  avatarUrl     String?
  role          String          @default("user") // "user" | "admin"
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  watchProgress WatchProgress[]
  wishlists     Wishlist[]
  ratings       Rating[]
  pushSubs      PushSubscription[]
}

// A browser Web Push subscription (one per device/browser the user enables).
model PushSubscription {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([profileId])
}

// Dedupe log so a given episode is pushed to a user at most once.
model SentPush {
  id        String   @id @default(uuid())
  profileId String
  episodeId String // `${mediaId}:${season}:${episode}`
  createdAt DateTime @default(now())

  @@unique([profileId, episodeId])
}

// A user's personal rating (1–10) for a title.
model Rating {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId   String
  mediaType String // "movie" | "tv"
  rating    Int // 1–10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, mediaId, mediaType])
  @@index([profileId])
}

// A user-submitted "this provider isn't working" report, surfaced to admins.
model ProviderReport {
  id            String   @id @default(uuid())
  providerKey   String
  providerLabel String?
  mediaId       String
  mediaType     String
  title         String?
  profileId     String? // reporter (null if signed out)
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([providerKey])
}

// Embeddable video provider. URL fields are templates that support the
// placeholders {id}, {season}, {episode}.
model Provider {
  id             String   @id @default(uuid())
  key            String   @unique // stable slug used in ?source= and as identity
  label          String
  sub            String?
  movieUrl       String // e.g. https://host/movie/{id}
  tvUrl          String // e.g. https://host/tv/{id}/{season}/{episode}
  sandboxMode    String   @default("balanced") // "strict" | "balanced" | "off" — iframe sandbox profile
  enabled        Boolean  @default(true) // hidden from the player when false
  isDefault      Boolean  @default(false) // selected provider when a link has no ?source=
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model WatchProgress {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId     String   // Movie ID or Show ID (from TMDb)
  mediaType   String   // "movie" or "tv"
  title       String
  posterPath  String?
  season      Int?     // For TV Shows (optional)
  episode     Int?     // Last-watched episode for the season (TV); updated in place
  progress    Int      // Progress in seconds
  duration    Int      // Total duration in seconds
  updatedAt   DateTime @default(now()) @updatedAt

  // One record per season (movies use season 0). Episode is a mutable column,
  // not part of the identity — a new episode updates the season's row.
  @@unique([profileId, mediaId, mediaType, season])
  @@index([profileId, updatedAt(sort: Desc)])
}

model Wishlist {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId     String   // Movie ID or Show ID
  mediaType   String   // "movie" or "tv"
  title       String
  posterPath  String?
  rating      Float?
  releaseDate String?
  createdAt   DateTime @default(now())

  @@unique([profileId, mediaId, mediaType])
  @@index([profileId])
}

// One playlist from the m3u-rest-api index (4,684 of them). `count` is the
// upstream station count; `stations` is what we have actually cached locally.
model RadioCategory {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  url       String
  count     Int            @default(0)
  // Section the category is filed under in the UI: "genre" | "decade" |
  // "language" | "country" | "theme" | "other". Derived from the slug.
  group     String         @default("other")
  // Set once the category's stations have been pulled from upstream and
  // cached. NULL means "not hydrated yet" — the first visit fetches on demand.
  hydratedAt DateTime?
  stations  RadioStation[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([group])
  @@index([hydratedAt])
}

model RadioStation {
  id         String        @id @default(uuid())
  name       String
  url        String
  categoryId String
  category   RadioCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Listener reports that the stream is dead. Crossing BROKEN_REPORT_THRESHOLD
  // flips isBroken, which sorts the station last and badges it in the UI.
  reportCount Int          @default(0)
  isBroken    Boolean      @default(false)
  // Admin kill switch. Disabled stations stay in the catalogue but are hidden
  // from listeners — used for streams that are dead or unwanted.
  isActive    Boolean      @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  // Re-hydrating a category must not duplicate its stations.
  @@unique([categoryId, url])
  @@index([categoryId])
  @@index([name])
  @@index([isBroken])
  @@index([isActive])
}
