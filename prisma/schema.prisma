// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String          @id // Synced with Supabase Auth user ID (UUID)
  email         String          @unique
  username      String?
  avatarUrl     String?
  role          String          @default("user") // "user" | "admin"
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  watchProgress WatchProgress[]
  wishlists     Wishlist[]
}

// Embeddable video provider. URL fields are templates that support the
// placeholders {id}, {season}, {episode}.
model Provider {
  id             String   @id @default(uuid())
  key            String   @unique // stable slug used in ?source= and as identity
  label          String
  sub            String?
  movieUrl       String // e.g. https://host/movie/{id}
  tvUrl          String // e.g. https://host/tv/{id}/{season}/{episode}
  sandboxEnabled Boolean  @default(true) // default iframe sandbox state for this provider
  enabled        Boolean  @default(true) // hidden from the player when false
  isDefault      Boolean  @default(false) // selected provider when a link has no ?source=
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model WatchProgress {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId     String   // Movie ID or Show ID (from TMDb)
  mediaType   String   // "movie" or "tv"
  title       String
  posterPath  String?
  season      Int?     // For TV Shows (optional)
  episode     Int?     // For TV Shows (optional)
  progress    Int      // Progress in seconds
  duration    Int      // Total duration in seconds
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([profileId, mediaId, mediaType, season, episode])
  @@index([profileId, updatedAt(sort: Desc)])
}

model Wishlist {
  id          String   @id @default(uuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mediaId     String   // Movie ID or Show ID
  mediaType   String   // "movie" or "tv"
  title       String
  posterPath  String?
  rating      Float?
  releaseDate String?
  createdAt   DateTime @default(now())

  @@unique([profileId, mediaId, mediaType])
  @@index([profileId])
}
